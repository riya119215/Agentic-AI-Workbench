שרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפכךזשרפשרפקצעלכחצץסיטולכחלכחלכחנןכצץסכךזשרפשרפשרפשרפשרפףעמלכחלכחלכחףעמשרפשרפכךזשרפשרפקצעלכחשרפשרפשרפכךזשרפשרפשרפשרפשרפכךזשרפשרפיטולכחלכחלכחףעמקצףמםךשרפשרפשרפשרפףעמלכחכךחטחד״׳װְֳִלכחףעמשרפשרפשרפםליצץסשרפשרפשרפכךזשרפשרפשרפםלטיטושרפשרפיטולכחלכחלכחףעמשרפשרפשרפשרפכךזשרפשרפשרפשרפשרפעסמיטהלכחלכחמםישרפצץסמםילכחמםיצץסשרפעסמיטהלכחלכחמםישרפצץסמםילכחםלטצץסשרפשרפשרפשרפצץסמםילכחמםיצץסשרפצץסלכטלכחלכטצץסשרפצץסלכטלכחלכטצץסשרפצץסלכחלכחןןכשרפשרפעסמיטהלכחלכחמםישרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפעענשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסצץסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסצץסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףףסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפססןשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפרקףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפכךזשרפשרפשרפשרפשרפףעמלכחלכחלכחףעמשרפשרפעסמלכחלכחמםיצץסשרפשרפשרפעסםייזצץסשרפףעמלכטלכחטחהלכחלכחעסםכךזשרפשרפףעמלכחלכחלכחףעמשרפשרפיטולכטשרפשרפשרפכךזשרפשרפשרפשרפשרפשרפיטולכחלכחלכחףעמשרפשרפעסםייזצץסשרפצץסלכטשרפשרפשרפםלטצץסשרפשרפשרפשרפשרפףעמךיזשרפשרפיטולכחלכחלכחףעמשרפשרפשרפכךזשרפשרפשרפשרפכךזשרפשרפכךזשרפשרפעסםלכחלכחםליצץסשרפשרפכךזשרפשרפשרפשרפכךזשרפשרפשרפשרפיטולכחלכחלכחצץסרקףיטולכחלכחלכחףעמקצעיטולכחלכחלכחעסםשרפצץסםלילכחםלטצץסשרפצץסםלילכחםלטצץסרקפכךזשרפשרפשרפכךזשרפשרפיטולכחלכחלכחףעמקצעיטולכחלכחלכחעסםשרפשרפשרפעסםלכחלכחםליצץסשרפשרפיטולכחלכחלכחעסםצץסיטהלכטשרפשרפשרפכךזשרפשרפיטולכחלכחלכחעסםצץעיטולכחלכחלכחףעמשרפשרפעסםייזצץסשרפףעמלכטלכחטחהלכחלכחעסםכךזנןםשרפףעמלכחלכחלכחףעמשרפשרפיטולכטשרפשרפשרפכךזשרפשרפשרפשרפעסמלכחלכחמםיצץסשרפשרפשרפעסםייזצץסשרפשרפצץסםלילכחםלטצץסרקפכךזשרפשרפיטולכטשרפשרפשרפכךזשרפשרפעסםלכחלכחםליצץסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפעענשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסםלילכחםלטצץסףעמלכטלכחטחהלכחלכחףעמשרפעסםייזצץסשרפשרפיטולכטשרפשרפשרפכךזשרפשרפיטולכחלכחלכחףעמשרפשרפשרפעסםייזצץסשרפשרפיטולכחלכחלכחףעמקצעיטולכחלכחלכחףעמשרפשרפשרפשרפשרפשרפצץסםלילכח