פשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןםשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףףסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפססןשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסףעמרקףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףףסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסןמככךחשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפלכחשרפצץסףעמשרפשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפצץסףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפקצףןמךמםיםלטףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפלכחשרפשרפשרפשרפשרפצץסףעמשרפשרפלכחשרפשרפשרפשרפצץסףעמשרפשרפףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץסףעמשרפשרפףעמשרפשרפשרפשרפשרפשרפשרפףעמשרפצץסףעמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפצץס