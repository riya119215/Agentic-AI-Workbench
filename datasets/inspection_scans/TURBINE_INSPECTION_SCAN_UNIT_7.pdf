רפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפססןשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפעענשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפססןשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפףףסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןלשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןםשרפשרפשרפשרפשרפשרפשרפשרפשרפףףסשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפפפעשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפעענשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפץץףשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפננמשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפנןכ‹‹‹נןכשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפכךזשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפשרפש